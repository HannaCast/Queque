# Copia a .env y ajusta. Ninguno es obligatorio: todos tienen un valor por defecto.
QUEQUE_DATOS=./datos
QUEQUE_ANALIZADOR=ollama            # "ollama" (modelo local) o "falso" (pruebas sin modelo)
QUEQUE_OLLAMA_URL=http://localhost:11434
QUEQUE_OLLAMA_MODELO=qwen2.5:3b     # ejemplo; el modelo definitivo está por decidir
QUEQUE_OLLAMA_TIMEOUT_S=600
QUEQUE_LIMITE_MEM_MB=1024           # tope de RAM adicional para leer el archivo (solo Linux)
QUEQUE_LIMITE_TIEMPO_S=120
QUEQUE_MAX_UPLOAD_MB=10
QUEQUE_TOKEN_INTRANET=              # si se define, /api/intranet/sync exige "Authorization: Bearer <token>"
QUEQUE_CORS=http://localhost:5173
QUEQUE_CONFIRMACION_AUTOMATICA=0   # 0 = una persona confirma (README del repo); 1 = se confirma sola (requisito del documento original)
QUEQUE_SESION_HORAS=8              # cuánto dura una sesión iniciada
QUEQUE_COOKIE_SEGURA=0             # 1 en producción con HTTPS: la cookie de sesión solo viaja cifrada
