{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queque.local/brief.schema.json",
  "title": "Brief de proyecto",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proyecto",
    "resumen",
    "areas_requeridas",
    "tareas",
    "supuestos",
    "preguntas_pendientes"
  ],
  "properties": {
    "proyecto": {
      "type": "string",
      "minLength": 1
    },
    "resumen": {
      "type": "string"
    },
    "areas_requeridas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "horas_estimadas",
          "porcentaje_sugerido",
          "confianza",
          "justificacion"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": ["Software", "Redes", "Marketing", "Mecatrónica"]
          },
          "horas_estimadas": {
            "type": "number",
            "minimum": 0
          },
          "porcentaje_sugerido": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confianza": {
            "type": "string",
            "enum": ["alta", "media", "baja"]
          },
          "justificacion": {
            "type": "string"
          }
        }
      }
    },
    "tareas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "area", "prioridad", "depende_de"],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "enum": ["Software", "Redes", "Marketing", "Mecatrónica"]
          },
          "prioridad": {
            "type": "string",
            "enum": ["alta", "media", "baja"]
          },
          "depende_de": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supuestos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preguntas_pendientes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
